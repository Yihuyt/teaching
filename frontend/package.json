{
  "name": "teaching-platform-frontend",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit --project tsconfig.app.json",
    "lint": "oxlint src tests vite.config.ts --deny-warnings",
    "test": "vitest run",
    "install:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config tests/e2e/playwright.config.ts",
    "generate:api": "orval -i src/api/api-v1.json -o src/api/generated/index.ts --client axios --formatter prettier --clean src/api/generated --fail-on-warnings",
    "check:api-client": "npm run generate:api && git diff --exit-code -- src/api/generated"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@element-plus/icons-vue": "^2.3.2",
    "@mdit/plugin-katex": "^1.0.1",
    "@noble/hashes": "^2.2.0",
    "axios": "1.18.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.6",
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "pinia": "4.0.2",
    "scratchblocks": "^3.7.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "axios-mock-adapter": "^2.1.0",
    "jsdom": "^26.1.0",
    "orval": "^8.22.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "ws": "8.21.1"
  }
}
