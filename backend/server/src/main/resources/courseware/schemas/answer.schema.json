{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/GeneratedAnswer",
  "definitions": {
    "GeneratedAnswer": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "口语化回答文本(展示并可朗读)"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          },
          "description": "回答时联动的视觉动作(highlight 指向本页块;目标经服务端校验)"
        }
      },
      "required": [
        "text",
        "actions"
      ],
      "additionalProperties": false,
      "description": "课堂问答:学生播放中提问 → 结合当前页内容作答"
    },
    "Action": {
      "anyOf": [
        {
          "$ref": "#/definitions/HighlightAction"
        },
        {
          "$ref": "#/definitions/RevealAction"
        },
        {
          "$ref": "#/definitions/PauseAction"
        }
      ]
    },
    "HighlightAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "highlight"
        },
        "target": {
          "$ref": "#/definitions/ActionTarget"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false
    },
    "ActionTarget": {
      "type": "string",
      "description": "动作目标:块 id(`blk-bullets-1`),bullets 子条目可用 `blk-bullets-1#2` 定位第 2 条(1 起数)。"
    },
    "RevealAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "reveal"
        },
        "target": {
          "$ref": "#/definitions/ActionTarget"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false,
      "description": "显示此前隐藏的块(用于逐步呈现;未被任何 reveal 引用的块默认可见)"
    },
    "PauseAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pause"
        },
        "ms": {
          "type": "number",
          "description": "朗读完本段后追加的停顿毫秒数,范围 [200, 5000]"
        }
      },
      "required": [
        "type",
        "ms"
      ],
      "additionalProperties": false
    }
  }
}
