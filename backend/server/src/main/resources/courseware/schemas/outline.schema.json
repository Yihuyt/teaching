{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/GeneratedOutline",
  "definitions": {
    "GeneratedOutline": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "课件标题"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OutlineScene"
          }
        }
      },
      "required": [
        "title",
        "scenes"
      ],
      "additionalProperties": false,
      "description": "教学需求 → 逐页大纲"
    },
    "OutlineScene": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/SceneType"
        },
        "preset": {
          "$ref": "#/definitions/PresetName",
          "description": "布局预设;content 页从除 quiz 外的 5 种中选,quiz 页固定 \"quiz\",interactive 页固定 \"standard\""
        },
        "summary": {
          "type": "string",
          "description": "本页要讲什么(2~3 句),是逐页生成内容的直接依据"
        },
        "keyPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 8,
          "description": "本页要点:2~5 条,每条一句话说清一个知识点或结论;测验页写考查点,交互页写学生要探索或做到的事。逐页生成内容时逐条落实"
        },
        "widgetType": {
          "$ref": "#/definitions/WidgetType",
          "description": "交互页组件类型。type=interactive 时必填(四选一),其余页面类型禁止出现"
        },
        "widgetOutline": {
          "$ref": "#/definitions/WidgetOutline",
          "description": "交互页组件规格。type=interactive 时必填,与 widgetType 配套;其余页面类型禁止出现"
        },
        "imageIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "放到本页的素材图片 id(只能用「可用图片」里列出的 id,只给讲解页);没有合适的图就省略"
        },
        "illustration": {
          "$ref": "#/definitions/Illustration",
          "description": "本页要 AI 画的一张配图(只给讲解页;素材里没有合适的图而这页确实需要一张示意图/插画时才写);没有就省略"
        }
      },
      "required": [
        "title",
        "type",
        "preset",
        "summary",
        "keyPoints"
      ],
      "additionalProperties": false
    },
    "WidgetType": {
      "type": "string",
      "enum": [
        "simulation",
        "diagram",
        "game",
        "visualization3d"
      ],
      "description": "交互组件四选一:simulation 参数仿真 / diagram 交互图解 / game 教学游戏 / visualization3d 3D 可视化"
    },
    "WidgetOutline": {
      "type": "object",
      "properties": {
        "concept": {
          "type": "string",
          "description": "simulation:仿真的核心概念名(如 projectile_motion)"
        },
        "keyVariables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "simulation:学生可调节的关键变量列表(如 [\"angle\", \"velocity\"])"
        },
        "diagramType": {
          "type": "string",
          "enum": [
            "flowchart",
            "mindmap",
            "hierarchy",
            "system"
          ],
          "description": "diagram:图解形态"
        },
        "nodeCount": {
          "type": "integer",
          "description": "diagram:节点数上限"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "parentId": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "description": "diagram:指定节点清单(可选;给了就必须原样全用)"
        },
        "gameType": {
          "type": "string",
          "enum": [
            "action",
            "puzzle",
            "strategy",
            "card",
            "quiz"
          ],
          "description": "game:玩法类型,优先 action(禁把选择题包装成游戏)"
        },
        "challenge": {
          "type": "string",
          "description": "game:玩家要「做」什么(不是「答」什么),如 \"控制推力使飞船以低于 5m/s 的速度着陆\""
        },
        "playerControls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "game:玩家控制的对象(如 [\"thrust_slider\"])"
        },
        "visualizationType": {
          "type": "string",
          "enum": [
            "molecular",
            "solar",
            "anatomy",
            "geometry",
            "physics",
            "custom"
          ],
          "description": "visualization3d:场景类型"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "visualization3d:要创建的 3D 对象(如 [\"sun\", \"earth\"])"
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "visualization3d:交互控件(如 [\"orbit\", \"speed_slider\"])"
        }
      },
      "additionalProperties": true,
      "description": "组件规格(松散对象):每种 widgetType 只读取自己认识的字段,允许补充额外描述字段(如 physicsConcept)供内容生成参考"
    },
    "SceneType": {
      "type": "string",
      "enum": [
        "content",
        "quiz",
        "interactive"
      ]
    },
    "PresetName": {
      "type": "string",
      "enum": [
        "title-cover",
        "standard",
        "two-column",
        "media-right",
        "quiz",
        "section-divider"
      ],
      "description": "布局预设:决定页面的区域框架(标题条 + 内容区)"
    },
    "Illustration": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "画面描述:画什么、有哪些元素、什么风格,具体到画师能照着画;图里要出现的文字标注写明用简体中文"
        },
        "aspectRatio": {
          "type": "string",
          "enum": [
            "16:9",
            "4:3",
            "1:1",
            "3:4"
          ],
          "description": "宽高比:media-right 页用 1:1 或 3:4,standard 页放文字下方用 16:9 或 4:3"
        }
      },
      "required": [
        "prompt",
        "aspectRatio"
      ],
      "additionalProperties": false,
      "description": "AI 配图请求"
    }
  }
}
