{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "知识点消歧裁决",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pairId": { "type": "integer", "minimum": 0 },
          "merge": { "type": "boolean" }
        },
        "required": ["pairId", "merge"],
        "additionalProperties": false
      }
    }
  },
  "required": ["decisions"],
  "additionalProperties": false
}
