{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "小节摘要",
  "type": "object",
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    }
  },
  "required": ["summary", "keywords"],
  "additionalProperties": false
}
