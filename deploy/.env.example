# Copy to deploy/.env and fill the non-secret deployment settings.
# Passwords and AccessKeys are read only from files under deploy/secrets.

COMPOSE_PROJECT_NAME=teaching-platform
WEB_PORT=8067

ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_RESOURCE_BUCKET=
ALIYUN_OSS_TESTCASE_BUCKET=

# 大模型/MinerU 密钥是用户级配置（教师在「账户设置 → AI 服务」自行配置，
# 加密落库；加密密钥在 deploy/secrets/ai-config-key），平台不持有业务密钥。

SESSION_COOKIE_SECURE=false

# 判题机横向扩展:每台副本的并发 / CPU / 内存上限(改动后需重建容器)
#JUDGE_WORKER_CONCURRENCY=1
#JUDGE_WORKER_CPUS=2
#JUDGE_WORKER_MEMORY=2g
# 后端容器内存上限(教材构建的整本正文与并行模型调用都在这个进程里)
#BACKEND_MEMORY=6g
